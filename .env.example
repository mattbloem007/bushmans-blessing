# Contentful Delivery API (read-only — used by Gatsby at build time)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# Contentful Management API (write access — only needed to run scripts/contentful-setup.js once)
CONTENTFUL_MANAGEMENT_TOKEN=

# Cloudflare Web Analytics beacon token (from the Cloudflare dashboard, Web Analytics > your site)
CLOUDFLARE_BEACON_TOKEN=

# Stripe (test-mode keys until the business is ready to go live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GATSBY_STRIPE_PUBLISHABLE_KEY=

# Resend (order confirmation emails, sent from the stripe-webhook function)
RESEND_API_KEY=
# Must be on a domain verified in Resend — falls back to onboarding@resend.dev (Resend's own test sender) until then
ORDER_EMAIL_FROM=
