# Contentful Delivery API (read-only — used by Gatsby at build time)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# Contentful Management API (write access — only needed to run scripts/contentful-setup.js once)
CONTENTFUL_MANAGEMENT_TOKEN=

# Cloudflare Web Analytics beacon token (from the Cloudflare dashboard, Web Analytics > your site)
CLOUDFLARE_BEACON_TOKEN=

# Stripe (test-mode keys until the business is ready to go live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GATSBY_STRIPE_PUBLISHABLE_KEY=
# Mantis Collective's Stripe Connect account ID (acct_...), linked via
# Stripe Connect OAuth. Each Kanna tincture sale transfers their €3.50 share
# there directly; Stripe includes it in their normal payout schedule.
MANTIS_COLLECTIVE_STRIPE_ACCOUNT_ID=

# Resend (order confirmation emails, sent from the stripe-webhook function)
RESEND_API_KEY=
# Must be on a domain verified in Resend — falls back to onboarding@resend.dev (Resend's own test sender) until then
ORDER_EMAIL_FROM=
# Where internal "new order" notifications are sent for fulfillment
ORDER_NOTIFICATION_EMAIL=
# Shared password required by the /admin/ship page to send shipping-notification emails
ADMIN_SHIP_SECRET=

# Set to "true" to bring back the /experiences page, its homepage section,
# and its nav link. Left unset/false while the site awaits Stripe approval.
GATSBY_SHOW_EXPERIENCES=
